# Required — Cognito User Pool
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-app-client-id

# Optional — defaults shown
AWS_REGION=us-east-1

# Optional — comma-separated emails allowed to use non-default Bedrock models for compaction.
# Leave empty to disable the feature for everyone.
DEMO_MODELS_ALLOWED_EMAILS=
